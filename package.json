{
  "name": "contactia",
  "version": "1.0.0",
  "description": "Asistente virtual Contactia para reservas y gestión de restaurantes con Airtable y Resend.",
  "main": "index.js",
  "scripts": {
    "postinstall": "node scripts/preparar-sdk-livekit.js",
    "start": "vercel dev",
    "test": "node --test",
    "test:conversacion": "node scripts/ejecutar-bateria-conversacional.js && node scripts/ejecutar-escenarios-conversacion.js",
    "medir:simulado": "node scripts/medir-consumo-simulado.js",
    "medir:conversaciones": "node scripts/medir-guardados-simulado.js",
    "test:supabase": "node scripts/probar-supabase-local.js"
  },
  "engines": {
    "node": "22.x"
  },
  "license": "MIT",
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@twilio/voice-sdk": "2.18.5",
    "livekit-client": "2.17.2",
    "livekit-server-sdk": "2.19.2",
    "pdf-lib": "^1.17.1",
    "twilio": "^6.1.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "jsdom": "26.1.0"
  }
}
